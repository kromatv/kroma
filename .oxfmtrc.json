{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    ".claude/worktrees",
    "**/dist",
    "**/dist-*",
    "**/build",
    "clients/webos/service",
    "**/.tanstack",
    "**/*.gen.ts",
    "**/routeTree.gen.ts",
    "packages/core/src/locales/messages.d.ts",
    "apps/www/src/paraglide",
    "**/*.template.html",
    "clients/synology",
    "server",
    "apps/www/src/styles.css",
    "clients/mobile/google-services.json"
  ],
  "sortPackageJson": false,
  "sortImports": false
}
