diff --git a/android/src/main/java/expo/modules/video/player/VideoPlayer.kt b/android/src/main/java/expo/modules/video/player/VideoPlayer.kt
index 7ccce96..3a42518 100644
--- a/android/src/main/java/expo/modules/video/player/VideoPlayer.kt
+++ b/android/src/main/java/expo/modules/video/player/VideoPlayer.kt
@@ -64,6 +64,14 @@ class VideoPlayer(val context: Context, appContext: AppContext, source: VideoSou
   private var renderersFactory = DefaultRenderersFactory(context)
     .forceEnableMediaCodecAsynchronousQueueing()
     .setEnableDecoderFallback(true)
+    // KROMA: let Media3 find the bundled FFmpeg audio decoders. DefaultRenderersFactory
+    // discovers extension renderers by reflection, but only when the mode is not OFF,
+    // which is the default - so without this the decoders ship and are never used.
+    // ON, not PREFER: ON puts the extension renderers AFTER the MediaCodec ones, so the
+    // hardware decoder still wins wherever the device has one and FFmpeg only picks up
+    // what it cannot decode (DTS, TrueHD, unlicensed E-AC3). PREFER would put software
+    // decoding ahead of hardware for everything, which a TV SoC cannot afford.
+    .setExtensionRendererMode(DefaultRenderersFactory.EXTENSION_RENDERER_MODE_ON)
   private val listeners: MutableList<WeakReference<VideoPlayerListener>> = mutableListOf()
   private val currentVideoViewRef = MutableWeakReference<VideoView?>(null) { new, old ->
     sendEvent(PlayerEvent.TargetViewChanged(new, old))
