{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/lint-rules/debt/oxlintrc.json"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "jsPlugins": [
    {
      "name": "kroma",
      "specifier": "./packages/lint-rules/src/index.mjs"
    },
    {
      "name": "react-compiler",
      "specifier": "eslint-plugin-react-hooks"
    },
    {
      "name": "sonarjs",
      "specifier": "eslint-plugin-sonarjs"
    }
  ],
  "rules": {
    "react-compiler/config": "error",
    "react-compiler/error-boundaries": "error",
    "react-compiler/gating": "error",
    "react-compiler/globals": "error",
    "react-compiler/immutability": "error",
    "react-compiler/incompatible-library": "error",
    "react-compiler/preserve-manual-memoization": "error",
    "react-compiler/purity": "error",
    "react-compiler/refs": "error",
    "react-compiler/set-state-in-effect": "error",
    "react-compiler/set-state-in-render": "error",
    "react-compiler/static-components": "error",
    "react-compiler/unsupported-syntax": "error",
    "react-compiler/use-memo": "error",
    "no-nested-ternary": "error",
    "kroma/no-relative-workspace-imports": "error",
    "no-debugger": "error",
    "no-eval": "error",
    "no-constant-condition": "error",
    "no-var": "error",
    "kroma/no-react-forward-ref": "error",
    "kroma/no-comment-banners": "error",
    "kroma/index-reexports-only": "error",
    "kroma/no-nested-templates": "error",
    "kroma/owned-task-comments": "error",
    "kroma/no-redundant-jsdoc-tags": "error",
    "kroma/no-unknown-record-assertions": "error",
    "kroma/no-em-dashes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "no-useless-constructor": "error",
    "react/no-array-index-key": "error",
    "react/no-danger": "error",
    "typescript/no-empty-interface": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/no-document-cookie": "error",
    "max-lines-per-function": [
      "error",
      {
        "max": 30,
        "skipBlankLines": true,
        "skipComments": true,
        "IIFEs": true
      }
    ],
    "max-params": [
      "error",
      {
        "max": 3
      }
    ],
    "complexity": [
      "error",
      {
        "max": 8
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 3
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "sonarjs/no-nested-conditional": "error",
    "sonarjs/cognitive-complexity": ["error", 15],
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true
      }
    ],
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/no-implied-eval": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "string": true,
          "boolean": true
        },
        "ignoreConditionalTests": true
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/prefer-readonly": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "curly": ["error", "all"],
    "no-new-func": "error",
    "no-console": "error",
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "import/no-cycle": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": [
      "error",
      {
        "ignoreNonDOM": true
      }
    ],
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "kroma/no-boolean-flag-param": "error",
    "kroma/zod-nonempty": "error",
    "kroma/import-boundaries": [
      "error",
      {
        "aliases": {
          "#web/": "clients/web/src/",
          "#tv/": "packages/tv/src/",
          "#ui/": "packages/ui/src/"
        },
        "slices": ["clients/web/src/features", "packages/tv/src/features"],
        "ladders": [
          [
            "packages/ui/src/core/tokens",
            "packages/ui/src/components/atoms",
            "packages/ui/src/components/molecules",
            "packages/ui/src/components/organisms",
            "packages/ui/src/components/templates"
          ],
          ["clients/web/src/shared", "clients/web/src/features", "clients/web/src/routes"],
          ["packages/tv/src/shared", "packages/tv/src/features"]
        ]
      }
    ]
  },
  "ignorePatterns": [
    ".claude/worktrees",
    ".claude/skills",
    "**/dist",
    "**/dist-*",
    "**/build",
    "clients/webos/service",
    "**/.tanstack",
    "**/*.gen.ts",
    "**/routeTree.gen.ts",
    "packages/core/src/locales/messages.d.ts",
    "modules/*/ui/src/messages.d.ts",
    "apps/www/src/paraglide",
    "**/*.template.html",
    "clients/synology",
    "server",
    "apps/www/src/styles.css",
    "clients/mobile/google-services.json"
  ],
  "overrides": [
    {
      "files": [
        "packages/ui/src/components/**/*.ts",
        "packages/ui/src/components/**/*.tsx",
        "packages/tv/src/**/*.ts",
        "packages/tv/src/**/*.tsx"
      ],
      "excludeFiles": ["**/*.test.*", "**/*.d.ts"],
      "rules": {
        "kroma/no-platform-branch": "error"
      }
    },
    {
      "files": [
        "packages/core/src/**/*.ts",
        "packages/client/src/**/*.ts",
        "packages/ui/src/**/*.ts",
        "packages/tv/src/**/*.ts",
        "packages/spatial-nav/src/**/*.ts",
        "packages/module-sdk/src/**/*.ts",
        "packages/core/src/**/*.tsx",
        "packages/client/src/**/*.tsx",
        "packages/ui/src/**/*.tsx",
        "packages/tv/src/**/*.tsx",
        "packages/spatial-nav/src/**/*.tsx",
        "packages/module-sdk/src/**/*.tsx",
        "clients/*/src/**/*.ts",
        "clients/*/src/**/*.tsx"
      ],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/*.d.ts"],
      "rules": {
        "kroma/no-module-mutable-bindings": "error"
      }
    },
    {
      "files": [
        "packages/ui/src/components/**/*.ts",
        "packages/ui/src/components/**/*.tsx",
        "packages/tv/src/**/*.ts",
        "packages/tv/src/**/*.tsx",
        "clients/*/src/**/*.ts",
        "clients/*/src/**/*.tsx",
        "apps/kit/src/**/*.ts",
        "apps/kit/src/**/*.tsx"
      ],
      "excludeFiles": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.fixture.*",
        "**/*.fixtures.*",
        "**/*.d.ts",
        "packages/ui/src/lib/icons/**"
      ],
      "rules": {
        "kroma/no-raw-design-values": "error"
      }
    },
    {
      "files": [
        "packages/ui/src/**/*.ts",
        "packages/ui/src/**/*.tsx",
        "packages/tv/src/**/*.ts",
        "packages/tv/src/**/*.tsx"
      ],
      "excludeFiles": [
        "packages/**/*.web.ts",
        "packages/**/*.web.tsx",
        "packages/**/*.test.ts",
        "packages/**/*.test.tsx",
        "packages/ui/src/components/organisms/kroma-intro/**",
        "packages/tv/src/shared/preview/**",
        "packages/tv/src/features/playback/player/avplayEngine.ts",
        "packages/tv/src/features/playback/player/htmlEngine.ts",
        "packages/tv/src/features/playback/player/useNowPlaying.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/preview/**",
        "packages/ui/src/lib/dom.ts",
        "packages/ui/src/services/themeAudio.ts",
        "packages/tv/src/shared/preview/cards.test.ts",
        "packages/tv/src/shared/preview/deeplink.test.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Audio",
            "message": "Browser-only. React Native throws ReferenceError, which the runtime turns into SIGABRT. Add a `.web.ts` half and give the native side its own."
          },
          {
            "name": "AudioContext",
            "message": "Browser-only. Add a `.web.ts` half."
          },
          {
            "name": "IntersectionObserver",
            "message": "Browser-only. Grow from a measured scroll position instead (see @kromatv/ui useGrowingCount)."
          },
          {
            "name": "MutationObserver",
            "message": "Browser-only. Add a `.web.ts` half."
          },
          {
            "name": "document",
            "message": "Browser-only. React Native has no DOM: add a `.web.ts` half, or guard with `typeof document !== 'undefined'`."
          },
          {
            "name": "getComputedStyle",
            "message": "Browser-only. Measure with onLayout instead."
          },
          {
            "name": "localStorage",
            "message": "Browser-only. React Native has none: use the client's device store (see setSessionStorage)."
          },
          {
            "name": "matchMedia",
            "message": "Browser-only. Use Platform / useWindowDimensions."
          },
          {
            "name": "sessionStorage",
            "message": "Browser-only. React Native has none."
          },
          {
            "name": "window",
            "message": "The worst one: React Native DEFINES `window` (it is `global`), so `typeof window !== 'undefined'` passes and `window.addEventListener` is then undefined rather than absent - \"undefined is not a function\", at render, on a TV. Use `webWindow()` from @kromatv/ui/kit, or add a `.web.ts` half."
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off"
      }
    },
    {
      "files": [
        "packages/ci-tools/**",
        "packages/cli/**",
        "packages/installer/**",
        "packages/sonar-tools/**",
        "packages/shots/**",
        "packages/tv-probe/**",
        "packages/workspace-tools/**",
        "packages/lint-rules/**",
        "packages/bundler/**",
        "packages/react-audit/**",
        "clients/tv-build/**",
        "clients/expo-build/**",
        "clients/android-build/**",
        "clients/bench/**",
        "docs/spec/scripts/**",
        "**/scripts/**",
        "**/*.config.ts",
        "**/*.config.mjs",
        "**/vite/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/lint-rules/**/*.test.mjs"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off"
      }
    },
    {
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@kromatv/web",
                  "@kromatv/web/*",
                  "@kromatv/tizen",
                  "@kromatv/tizen/*",
                  "@kromatv/webos",
                  "@kromatv/webos/*",
                  "@kromatv/mobile",
                  "@kromatv/mobile/*",
                  "@kromatv/desktop",
                  "@kromatv/desktop/*",
                  "@kromatv/tv-web",
                  "@kromatv/tv-web/*",
                  "@kromatv/tv-native",
                  "@kromatv/tv-native/*",
                  "@kromatv/site",
                  "@kromatv/site/*",
                  "@kromatv/kit",
                  "@kromatv/kit/*",
                  "@kromatv/modules-site",
                  "@kromatv/modules-site/*",
                  "@kromatv/package-source",
                  "@kromatv/package-source/*"
                ],
                "message": "A library never imports a shell or a site: the dependency runs from clients and apps down to packages (ARCHITECTURE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@kromatv/web",
                  "@kromatv/web/*",
                  "@kromatv/tizen",
                  "@kromatv/tizen/*",
                  "@kromatv/webos",
                  "@kromatv/webos/*",
                  "@kromatv/mobile",
                  "@kromatv/mobile/*",
                  "@kromatv/desktop",
                  "@kromatv/desktop/*",
                  "@kromatv/tv-web",
                  "@kromatv/tv-web/*",
                  "@kromatv/tv-native",
                  "@kromatv/tv-native/*",
                  "@kromatv/site",
                  "@kromatv/site/*",
                  "@kromatv/kit",
                  "@kromatv/kit/*",
                  "@kromatv/modules-site",
                  "@kromatv/modules-site/*",
                  "@kromatv/package-source",
                  "@kromatv/package-source/*"
                ],
                "message": "A library never imports a shell or a site: the dependency runs from clients and apps down to packages (ARCHITECTURE.md)."
              },
              {
                "group": ["@kromatv/tv", "@kromatv/tv/*"],
                "message": "The libraries are ordered client, core, ui, tv, each knowing only the ones before it (ARCHITECTURE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@kromatv/web",
                  "@kromatv/web/*",
                  "@kromatv/tizen",
                  "@kromatv/tizen/*",
                  "@kromatv/webos",
                  "@kromatv/webos/*",
                  "@kromatv/mobile",
                  "@kromatv/mobile/*",
                  "@kromatv/desktop",
                  "@kromatv/desktop/*",
                  "@kromatv/tv-web",
                  "@kromatv/tv-web/*",
                  "@kromatv/tv-native",
                  "@kromatv/tv-native/*",
                  "@kromatv/site",
                  "@kromatv/site/*",
                  "@kromatv/kit",
                  "@kromatv/kit/*",
                  "@kromatv/modules-site",
                  "@kromatv/modules-site/*",
                  "@kromatv/package-source",
                  "@kromatv/package-source/*"
                ],
                "message": "A library never imports a shell or a site: the dependency runs from clients and apps down to packages (ARCHITECTURE.md)."
              },
              {
                "group": ["@kromatv/ui", "@kromatv/ui/*", "@kromatv/tv", "@kromatv/tv/*"],
                "message": "The libraries are ordered client, core, ui, tv, each knowing only the ones before it (ARCHITECTURE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@kromatv/web",
                  "@kromatv/web/*",
                  "@kromatv/tizen",
                  "@kromatv/tizen/*",
                  "@kromatv/webos",
                  "@kromatv/webos/*",
                  "@kromatv/mobile",
                  "@kromatv/mobile/*",
                  "@kromatv/desktop",
                  "@kromatv/desktop/*",
                  "@kromatv/tv-web",
                  "@kromatv/tv-web/*",
                  "@kromatv/tv-native",
                  "@kromatv/tv-native/*",
                  "@kromatv/site",
                  "@kromatv/site/*",
                  "@kromatv/kit",
                  "@kromatv/kit/*",
                  "@kromatv/modules-site",
                  "@kromatv/modules-site/*",
                  "@kromatv/package-source",
                  "@kromatv/package-source/*"
                ],
                "message": "A library never imports a shell or a site: the dependency runs from clients and apps down to packages (ARCHITECTURE.md)."
              },
              {
                "group": [
                  "@kromatv/core",
                  "@kromatv/core/*",
                  "@kromatv/ui",
                  "@kromatv/ui/*",
                  "@kromatv/tv",
                  "@kromatv/tv/*"
                ],
                "message": "The libraries are ordered client, core, ui, tv, each knowing only the ones before it (ARCHITECTURE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["clients/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@kromatv/site",
                  "@kromatv/site/*",
                  "@kromatv/kit",
                  "@kromatv/kit/*",
                  "@kromatv/modules-site",
                  "@kromatv/modules-site/*",
                  "@kromatv/package-source",
                  "@kromatv/package-source/*"
                ],
                "message": "A client ships the product and an app is a website about it. The two never import each other (ARCHITECTURE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@kromatv/web",
                  "@kromatv/web/*",
                  "@kromatv/tizen",
                  "@kromatv/tizen/*",
                  "@kromatv/webos",
                  "@kromatv/webos/*",
                  "@kromatv/mobile",
                  "@kromatv/mobile/*",
                  "@kromatv/desktop",
                  "@kromatv/desktop/*",
                  "@kromatv/tv-web",
                  "@kromatv/tv-web/*",
                  "@kromatv/tv-native",
                  "@kromatv/tv-native/*"
                ],
                "message": "A client ships the product and an app is a website about it. The two never import each other (ARCHITECTURE.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/ui/src/components/**/*.fixtures.tsx",
        "packages/ui/src/components/**/*.fixture.ts",
        "packages/ui/src/components/**/*.test.ts",
        "packages/ui/src/components/**/*.test.tsx",
        "packages/ui/src/components/**/*.demo.tsx"
      ],
      "rules": {
        "kroma/import-boundaries": "off"
      }
    }
  ]
}
