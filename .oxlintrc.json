{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": [
    {
      "name": "kroma",
      "specifier": "./packages/lint-rules/src/index.mjs"
    }
  ],
  "rules": {
    "no-nested-ternary": "error",
    "kroma/no-relative-workspace-imports": "error",
    "no-debugger": "error",
    "no-eval": "error",
    "no-constant-condition": "error",
    "no-var": "error",
    "kroma/no-react-forward-ref": "error",
    "kroma/no-comment-banners": "error",
    "kroma/index-reexports-only": "error",
    "kroma/no-nested-templates": "error",
    "kroma/owned-task-comments": "error",
    "kroma/no-redundant-jsdoc-tags": "error",
    "kroma/no-unknown-record-assertions": "error",
    "kroma/no-em-dashes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "no-useless-constructor": "error",
    "react/no-array-index-key": "error",
    "react/no-danger": "error",
    "typescript/no-empty-interface": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/no-document-cookie": "error"
  },
  "ignorePatterns": [
    ".claude/worktrees",
    "**/dist",
    "**/dist-*",
    "**/build",
    "clients/webos/service",
    "**/.tanstack",
    "**/*.gen.ts",
    "**/routeTree.gen.ts",
    "packages/core/src/locales/messages.d.ts",
    "apps/www/src/paraglide",
    "**/*.template.html",
    "clients/synology",
    "server",
    "apps/www/src/styles.css",
    "clients/mobile/google-services.json"
  ],
  "overrides": [
    {
      "files": [
        "packages/core/src/**/*.ts",
        "packages/client/src/**/*.ts",
        "packages/ui/src/**/*.ts",
        "packages/tv/src/**/*.ts",
        "packages/spatial-nav/src/**/*.ts",
        "packages/module-sdk/src/**/*.ts",
        "packages/core/src/**/*.tsx",
        "packages/client/src/**/*.tsx",
        "packages/ui/src/**/*.tsx",
        "packages/tv/src/**/*.tsx",
        "packages/spatial-nav/src/**/*.tsx",
        "packages/module-sdk/src/**/*.tsx",
        "clients/*/src/**/*.ts",
        "clients/*/src/**/*.tsx"
      ],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/*.d.ts"],
      "rules": {
        "kroma/no-module-mutable-bindings": "error"
      }
    },
    {
      "files": [
        "packages/ui/src/components/**/*.ts",
        "packages/ui/src/components/**/*.tsx",
        "packages/tv/src/**/*.ts",
        "packages/tv/src/**/*.tsx",
        "clients/*/src/**/*.ts",
        "clients/*/src/**/*.tsx",
        "apps/kit/src/**/*.ts",
        "apps/kit/src/**/*.tsx"
      ],
      "excludeFiles": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.fixture.*",
        "**/*.fixtures.*",
        "**/*.d.ts",
        "packages/ui/src/lib/icons/**"
      ],
      "rules": {
        "kroma/no-raw-design-values": "error"
      }
    },
    {
      "files": [
        "packages/ui/src/**/*.ts",
        "packages/ui/src/**/*.tsx",
        "packages/tv/src/**/*.ts",
        "packages/tv/src/**/*.tsx"
      ],
      "excludeFiles": [
        "packages/**/*.web.ts",
        "packages/**/*.web.tsx",
        "packages/**/*.test.ts",
        "packages/**/*.test.tsx",
        "packages/ui/src/components/organisms/kroma-intro/**",
        "packages/tv/src/shared/preview/**",
        "packages/tv/src/features/playback/player/avplayEngine.ts",
        "packages/tv/src/features/playback/player/htmlEngine.ts",
        "packages/tv/src/features/playback/player/useNowPlaying.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/preview/**",
        "packages/ui/src/lib/dom.ts",
        "packages/ui/src/services/themeAudio.ts",
        "packages/tv/src/shared/preview/cards.test.ts",
        "packages/tv/src/shared/preview/deeplink.test.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Audio",
            "message": "Browser-only. React Native throws ReferenceError, which the runtime turns into SIGABRT. Add a `.web.ts` half and give the native side its own."
          },
          {
            "name": "AudioContext",
            "message": "Browser-only. Add a `.web.ts` half."
          },
          {
            "name": "IntersectionObserver",
            "message": "Browser-only. Grow from a measured scroll position instead (see @kromatv/ui useGrowingCount)."
          },
          {
            "name": "MutationObserver",
            "message": "Browser-only. Add a `.web.ts` half."
          },
          {
            "name": "document",
            "message": "Browser-only. React Native has no DOM: add a `.web.ts` half, or guard with `typeof document !== 'undefined'`."
          },
          {
            "name": "getComputedStyle",
            "message": "Browser-only. Measure with onLayout instead."
          },
          {
            "name": "localStorage",
            "message": "Browser-only. React Native has none: use the client's device store (see setSessionStorage)."
          },
          {
            "name": "matchMedia",
            "message": "Browser-only. Use Platform / useWindowDimensions."
          },
          {
            "name": "sessionStorage",
            "message": "Browser-only. React Native has none."
          },
          {
            "name": "window",
            "message": "The worst one: React Native DEFINES `window` (it is `global`), so `typeof window !== 'undefined'` passes and `window.addEventListener` is then undefined rather than absent - \"undefined is not a function\", at render, on a TV. Use `webWindow()` from @kromatv/ui/kit, or add a `.web.ts` half."
          }
        ]
      }
    }
  ]
}
