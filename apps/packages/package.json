{
  "name": "@kromatv/package-source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA package source (packages.kroma.tv): a TanStack Start app rendered on the edge, serving DSM's Package Center a live catalog assembled from the GitHub Releases API and everyone else a browsable list of every release.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "apps/packages"
  },
  "imports": {
    "#site/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3200",
    "build": "vite build",
    "typecheck": "tsr generate && tsc --noEmit",
    "generate-routes": "tsr generate",
    "deploy": "bun run build && bunx wrangler@4 deploy"
  },
  "dependencies": {
    "@kromatv/site-kit": "workspace:*",
    "@kromatv/site-meta": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@kromatv/bundler": "workspace:*",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "react-native-web": "^0.21.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.151.3"
  }
}
