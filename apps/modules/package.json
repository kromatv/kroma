{
  "name": "@kromatv/modules-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA module registry (modules.kroma.tv): a TanStack Start app rendered on the edge. Serves the RFC 110 documents and their schemas, plus a browsable grid of every module. The contract itself is `@kromatv/registry`.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "apps/modules"
  },
  "imports": {
    "#site/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3300",
    "build": "vite build",
    "typecheck": "tsr generate && tsc --noEmit",
    "generate-routes": "tsr generate",
    "deploy": "bun run build && bunx wrangler@4 deploy"
  },
  "dependencies": {
    "@kromatv/registry": "workspace:*",
    "@kromatv/site-kit": "workspace:*",
    "@kromatv/site-meta": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "hono": "^4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kromatv/bundler": "workspace:*",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-native-web": "^0.21.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  }
}
