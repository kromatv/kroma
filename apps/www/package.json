{
  "name": "@kromatv/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA's public site (kroma.tv). TanStack Start, prerendered to static assets on Cloudflare. Marketing pages and an MD/MDX blog, styled from the @kromatv/ui design tokens.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "apps/www"
  },
  "imports": {
    "#site/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3100",
    "build": "vite build",
    "preview": "vite preview --port 3100",
    "preview:edge": "bunx wrangler@4 dev",
    "deploy": "bun run build && bunx wrangler@4 deploy -c dist/server/wrangler.json",
    "generate-routes": "tsr generate",
    "typecheck": "bun run paraglide && tsr generate && tsc --noEmit",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url --emit-ts-declarations --silent"
  },
  "dependencies": {
    "@kromatv/registry": "workspace:*",
    "@kromatv/site-meta": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "@react-three/fiber": "^9.8.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "country-flag-icons": "^1.6.20",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@inlang/paraglide-js": "^2.29.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.45",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-geo": "^3.1.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.17.1",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "world-atlas": "^2.0.2"
  }
}
