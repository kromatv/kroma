{
  "name": "@kroma/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA's public site (kroma.tv). TanStack Start, prerendered to static assets on Cloudflare. Marketing pages and an MD/MDX blog, styled from the @kroma/ui design tokens.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxscharwath/kroma.git",
    "directory": "apps/www"
  },
  "imports": {
    "#site/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3100",
    "build": "vite build",
    "preview": "vite preview --port 3100",
    "preview:edge": "bunx wrangler@4 dev",
    "deploy": "bun run build && bunx wrangler@4 deploy -c dist/server/wrangler.json",
    "generate-routes": "tsr generate",
    "typecheck": "bun run paraglide && tsr generate && tsc --noEmit",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url --emit-ts-declarations --silent"
  },
  "dependencies": {
    "@kroma/registry": "workspace:*",
    "@kroma/site-meta": "workspace:*",
    "@kroma/ui": "workspace:*",
    "@mdx-js/react": "^3.1.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@inlang/paraglide-js": "^2.24.0",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.30",
    "@tanstack/router-plugin": "^1.168.32",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
