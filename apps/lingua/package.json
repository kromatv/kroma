{
  "name": "@kromatv/lingua",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lingua (lingua.kroma.tv): translate a repository's catalogs in the browser, sign in with GitHub, and send each contributor's suggestions as a rolling pull request. Self-hosted on Cloudflare Workers + D1, reading public repositories on a cron.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "apps/lingua"
  },
  "imports": {
    "#site/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3400",
    "build": "vite build",
    "typecheck": "tsr generate && tsc --noEmit",
    "generate-routes": "tsr generate",
    "migrate": "wrangler d1 migrations apply kroma-lingua --remote",
    "migrate:local": "wrangler d1 migrations apply kroma-lingua --local",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@kromatv/i18n": "workspace:*",
    "@kromatv/site-kit": "workspace:*",
    "@kromatv/site-meta": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "hono": "^4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kromatv/bundler": "workspace:*",
    "@kromatv/i18n-tools": "workspace:*",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-native-web": "^0.21.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  }
}
