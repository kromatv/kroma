{
  "name": "@kroma/kit",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "description": "KROMA design-system showcase: the @kroma/ui workbench as a deployable website AND as an app you can launch at a phone or a television simulator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:edge": "bunx wrangler@4 dev",
    "deploy": "bun run build && bunx wrangler@4 deploy",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "start:tv": "EXPO_TV=1 expo start",
    "ios:tv": "EXPO_TV=1 expo run:ios",
    "android:tv": "EXPO_TV=1 expo run:android",
    "expo:prebuild": "expo prebuild --clean",
    "expo:prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "pod": "cd ios && pod install",
    "bundle:check": "bun ../../clients/expo-build/bundle-check.ts .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kroma/core": "workspace:*",
    "@kroma/ui": "workspace:*",
    "@kroma/workbench": "workspace:*",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "npm:react-native-tvos@0.86.0-2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@kroma/build-info": "workspace:*",
    "@kroma/bundler": "workspace:*",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-preset-expo": "~57.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
