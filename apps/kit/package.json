{
  "name": "@kromatv/kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA design-system showcase: the @kromatv/ui workbench as a deployable website AND as an app you can launch at a phone or a television simulator.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "apps/kit"
  },
  "main": "index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:edge": "bunx wrangler@4 dev",
    "deploy": "bun run build && bunx wrangler@4 deploy",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "start:tv": "EXPO_TV=1 expo start",
    "ios:tv": "EXPO_TV=1 expo run:ios",
    "android:tv": "EXPO_TV=1 expo run:android",
    "expo:prebuild": "expo prebuild --clean",
    "expo:prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "pod": "cd ios && pod install",
    "bundle:check": "bun ../../clients/expo-build/bundle-check.ts .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kromatv/core": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "@kromatv/workbench": "workspace:*",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-keep-awake": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@kromatv/build-info": "workspace:*",
    "@kromatv/bundler": "workspace:*",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-preset-expo": "~58.0.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
