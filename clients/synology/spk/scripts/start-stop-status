#!/bin/sh
# DSM 7 service control for KROMA. One process: kroma-server serves the API,
# streaming, AND the bundled web SPA on a single port. ffmpeg/ffprobe are taken
# from the bundled ffmpeg/bin via PATH. Config (movies/series folders, port,
# optional data folder) is written by the install wizard (postinst) to
# var/kroma.conf.

PKG="kroma"
TARGET="/var/packages/${PKG}/target"
VAR="/var/packages/${PKG}/var"
RELEASES="${VAR}/releases"
PID="${VAR}/kroma.pid"
LOG="${VAR}/kroma.log"
RESTART=75

# shellcheck disable=SC1090
[ -f "${VAR}/kroma.conf" ] && . "${VAR}/kroma.conf"

# Data lives in the user-chosen folder (wizard) or, by default, under the
# package's own var. If the chosen path can't be created (e.g. permissions were
# never granted), fall back to var/data so the service still starts.
DATA_DIR="${KROMA_DATA_DIR:-}"
[ -n "${DATA_DIR}" ] || DATA_DIR="${VAR}/data"

# VA-API finds its driver by scanning LIBVA_DRIVERS_PATH. The package carries
# Intel's i965 driver, which covers every Intel Synology (Apollo Lake, Gemini
# Lake), and offers it first; the directories a Synology is known to keep one in
# follow, and libva ignores the ones that are not there.
va_drivers_path() {
    _p=""
    for d in "$1/ffmpeg/dri" \
             /var/packages/synocli-videodriver/target/lib \
             /usr/lib/dri /usr/lib/x86_64-linux-gnu/dri; do
        [ -d "$d" ] && _p="${_p:+$_p:}$d"
    done
    printf '%s' "$_p"
}

# The daemon appends its whole stdout here for the life of the install, and this
# is the only log that also carries the module sidecars' output, so it is the one
# an operator is sent to. Nothing rotated it: six weeks of a live NAS came to
# 16 MB and it only ever grew. One generation is kept, so the pair is bounded at
# twice the cap and a restart never costs the run that led up to it.
LOG_MAX_BYTES=8388608

roll_log() {
    [ -f "${LOG}" ] || return 0
    _size=$(wc -c < "${LOG}" 2>/dev/null) || return 0
    [ "${_size}" -gt "${LOG_MAX_BYTES}" ] || return 0
    mv -f "${LOG}" "${LOG}.1" 2>/dev/null
}

installed_build() {
    _v="${SYNOPKG_PKGVER:-$(sed -n 's/^version="\(.*\)"$/\1/p' "/var/packages/${PKG}/INFO" 2>/dev/null)}"
    case "${_v##*.}" in
        ''|*[!0-9]*) echo 0 ;;
        *) echo "${_v##*.}" ;;
    esac
}

newest_payload() {
    _dir="${TARGET}"
    _top=$(installed_build)
    for d in "${RELEASES}"/*; do
        _build="${d##*/}"
        case "${_build}" in ''|*[!0-9]*) continue ;; esac
        [ -x "${d}/bin/kroma-server" ] && [ "${_build}" -gt "${_top}" ] || continue
        _top="${_build}"
        _dir="${d}"
    done
    printf '%s' "${_dir}"
}

prune_releases() {
    for d in "${RELEASES}"/*; do
        [ -e "${d}" ] && [ "${d}" != "$1" ] && rm -rf "${d}"
    done
}

serve() {
    _child=""
    trap '[ -n "${_child}" ] && kill "${_child}" 2>/dev/null; wait "${_child}" 2>/dev/null; exit 0' TERM INT
    _operator_va="${LIBVA_DRIVERS_PATH:-}"
    while :; do
        _payload=$(newest_payload)
        prune_releases "${_payload}"
        # Only when something was found: an empty LIBVA_DRIVERS_PATH tells libva to
        # search nowhere, which is worse than leaving it its own default.
        _va="${_operator_va:-$(va_drivers_path "${_payload}")}"
        if [ -n "${_va}" ]; then export LIBVA_DRIVERS_PATH="${_va}"; else unset LIBVA_DRIVERS_PATH; fi
        PATH="${_payload}/ffmpeg/bin:${PATH}" \
        KROMA_PORT="${KROMA_PORT:-4040}" \
        KROMA_MOVIES_DIRS="${KROMA_MOVIES_DIRS}" \
        KROMA_SERIES_DIRS="${KROMA_SERIES_DIRS}" \
        KROMA_MEDIA_DIRS="${KROMA_MEDIA_DIRS}" \
        KROMA_DATA_DIR="${DATA_DIR}" \
        KROMA_WEB_DIR="${_payload}/web" \
        KROMA_INSTALL="synology" \
        KROMA_SELF_UPDATE_DIR="${RELEASES}" \
        "${_payload}/bin/kroma-server" &
        _child=$!
        wait "${_child}"
        _status=$?
        _child=""
        [ "${_status}" -eq "${RESTART}" ] || break
    done
}

start_daemon() {
    roll_log
    mkdir -p "${DATA_DIR}" 2>/dev/null
    if [ ! -d "${DATA_DIR}" ]; then
        echo "$(date) data folder ${DATA_DIR} unavailable, using ${VAR}/data" >> "${LOG}"
        DATA_DIR="${VAR}/data"
    fi
    mkdir -p "${DATA_DIR}" "${RELEASES}"
    serve >> "${LOG}" 2>&1 &
    echo $! > "${PID}"
}

stop_daemon() {
    if [ -f "${PID}" ]; then
        _pid=$(cat "${PID}")
        kill "${_pid}" 2>/dev/null
        _waited=0
        while kill -0 "${_pid}" 2>/dev/null && [ "${_waited}" -lt 30 ]; do
            sleep 1
            _waited=$((_waited + 1))
        done
    fi
    rm -f "${PID}"
}

daemon_status() {
    [ -f "${PID}" ] && kill -0 "$(cat "${PID}")" 2>/dev/null
}

case "$1" in
    start)  daemon_status || start_daemon ;;
    stop)   stop_daemon ;;
    status) daemon_status && exit 0 || exit 3 ;;
    *)      exit 1 ;;
esac
exit 0
