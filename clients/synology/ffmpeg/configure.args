--enable-gpl
--enable-version3
--disable-debug
--disable-doc
--disable-ffplay
--disable-autodetect
--disable-network
--disable-everything
--enable-shared
--disable-static
--enable-zlib
--enable-libx264
--enable-libdav1d
--enable-libwebp
--enable-decoders
--enable-parsers
--enable-bsfs
--enable-demuxers
--enable-hwaccels
--enable-protocol=file,pipe
--enable-indev=lavfi
--enable-encoder=libx264,aac,mjpeg,png,libwebp,webvtt,subrip,srt,mov_text,pcm_s16le,pcm_f32le,rawvideo,wrapped_avframe
--enable-muxer=hls,mp4,mov,matroska,webvtt,srt,null,rawvideo,pcm_s16le,pcm_f32le,image2,webp
--enable-filter=buffer,buffersink,abuffer,abuffersink,scale,crop,tile,format,aformat,fps,null,anull,copy,trim,atrim,setpts,asetpts,transpose,hflip,vflip,rotate,hwupload,hwdownload,acompressor,volume,asplit,pan,loudnorm,aresample,testsrc,testsrc2,color,sine
