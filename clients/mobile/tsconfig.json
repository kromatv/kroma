{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "allowImportingTsExtensions": true,
    "types": ["node", "react"],
    "paths": {
      "#mobile/*": ["./src/*"],
      "#mobile-assets/*": ["./assets/*"],
      "#ui/*": ["../../packages/ui/src/*"],
      "#tv/*": ["../../packages/tv/src/*"],
      "#web/*": ["../web/src/*"],
      "react-native": ["./node_modules/react-native/types_DEPRECATED/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "metro.config.ts", "android", "ios"]
}
