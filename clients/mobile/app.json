{
  "expo": {
    "name": "KROMA",
    "slug": "kroma",
    "version": "0.1.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "kroma",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "bundleIdentifier": "tv.kroma.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["en", "fr"],
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "KROMA finds your media server on your local network, and finds televisions in the same room so you can sign one in with a tap.",
        "NSBonjourServices": ["_http._tcp", "_kroma._tcp", "_kroma-tv._tcp"],
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production",
        "keychain-access-groups": ["$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)"]
      }
    },
    "android": {
      "package": "tv.kroma.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.NEARBY_WIFI_DEVICES", "android.permission.INTERNET"],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      ["@kromatv/android-build/plugin", { "formFactor": "mobile" }],
      "expo-router",
      "./plugins/with-cleartext-traffic",
      "@kesha-antonov/react-native-background-downloader",
      "./plugins/with-mmkv-pin",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "KROMA uses Face ID to unlock PIN-protected profiles."
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KROMA uses your photo library to set your profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KROMA scans your TV's QR code to sign it in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0A0A0C"
        }
      ],
      "@kromatv/media3-ffmpeg"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
