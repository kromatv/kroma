    "@kromatv/client": "workspace:*",
    "@kromatv/core": "workspace:*",
    "@kromatv/i18n": "workspace:*",
    "@kromatv/lan-beacon": "workspace:*",
    "@kromatv/media3-ffmpeg": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "@kromatv/workbench": "workspace:*",
    "@shopify/flash-list": "^2.3.3",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
