    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "bundle:check": "bun ../expo-build/bundle-check.ts ."
  },
  "dependencies": {
    "@kromatv/build-info": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.14",
