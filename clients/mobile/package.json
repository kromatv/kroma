    "@kroma/ui": "workspace:*",
    "@kroma/workbench": "workspace:*",
    "@tabler/icons-react-native": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.13",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
