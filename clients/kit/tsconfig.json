{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // `react-dom` and `vite/client` for the site half, `react` for both. The
    // native half needs no extra types: it reaches React Native only through
    // @kroma/ui, whose own program already carries them.
    "types": ["node", "react", "react-dom", "vite/client"],
    // DOM is in `lib` for the site, and it has to stay there for the native
    // half too: the shared @kroma/ui source this compiles carries the web side
    // of every platform split, and those branches must still TYPECHECK here
    // even though `Platform.OS` never reaches them in a Metro bundle.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "index.js", "vite.config.ts", "app.config.ts"]
}
