{
  "name": "@kromatv/tv-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA 10-foot TV experience served from the web (tv.kroma.tv) thin shell over @kromatv/tv.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "clients/tv-web"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:edge": "bunx wrangler@4 dev",
    "deploy": "bun run build && bunx wrangler@4 deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kromatv/tv": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@kromatv/bundler": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
