{
  "name": "@kroma/tizen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA Samsung Tizen TV client thin shell over @kroma/tv.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxscharwath/kroma.git",
    "directory": "clients/tizen"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.config.legacy.ts && vite build --config vite.config.deep.ts && bun scripts/build-service.ts && bun run check:legacy && bun ../tv-build/stamp-version.ts",
    "build:fast": "vite build",
    "check:legacy": "bun ../tv-build/check-legacy.ts",
    "check:simulator": "bun scripts/simulator-check.ts",
    "slice": "bun scripts/slice.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "doctor": "make doctor",
    "package": "make package",
    "deploy": "make deploy",
    "logs": "make logs"
  },
  "dependencies": {
    "@kroma/core": "workspace:*",
    "@kroma/tv": "workspace:*",
    "@kroma/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kroma/bundler": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
