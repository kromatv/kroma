{
  "name": "@kromatv/tv-native",
  "version": "0.0.0",
  "private": true,
  "description": "KROMA native TV client (Apple TV + Android TV): the shared @kromatv/tv experience compiled by React Native instead of rendered in a WebView.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "clients/tv-native"
  },
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "ios": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=\"$PWD/node_modules\" expo run:ios",
    "android": "EXPO_TV=1 expo run:android",
    "prebuild": "EXPO_TV=1 expo prebuild --clean",
    "pod": "cd ios && REACT_NATIVE_NODE_MODULES_DIR=\"$PWD/../node_modules\" pod install",
    "bundle:check": "bun ../expo-build/bundle-check.ts . EXPO_TV=1 --max 10",
    "typecheck": "tsc --noEmit",
    "focus:probe": "bun ./scripts/focus-probe.ts",
    "perf:androidtv": "bun ./scripts/perf-androidtv.ts"
  },
  "dependencies": {
    "@kromatv/build-info": "workspace:*",
    "@kromatv/client": "workspace:*",
    "@kromatv/core": "workspace:*",
    "@kromatv/lan-beacon": "workspace:*",
    "@kromatv/media3-ffmpeg": "workspace:*",
    "@kromatv/tv": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "expo": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-keep-awake": "~58.0.3",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "~58.0.18",
    "expo-atlas": "^0.4.3",
    "typescript": "^7.0.2"
  }
}
