{
  "name": "@kromatv/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA native desktop client: Tauri shell over @kromatv/tv with native mpv playback + gamepad input. Steam Deck is the primary target.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "clients/desktop"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles appimage",
    "tauri:build:mac": "tauri build --bundles app",
    "tauri:build:mac:dmg": "tauri build --bundles app,dmg",
    "tauri:icon": "tauri icon src-tauri/icons/icon.png"
  },
  "dependencies": {
    "@kromatv/client": "workspace:*",
    "@kromatv/tv": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kromatv/bundler": "workspace:*",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
