{
  "name": "@kromatv/webos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA LG webOS TV client thin shell over @kromatv/tv.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "clients/webos"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.config.legacy.ts && bun run check:legacy && bun run build:service && bun ../tv-build/stamp-version.ts",
    "check:legacy": "bun ../tv-build/check-legacy.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package": "echo 'Run: bun run build:webos, then: ares-package clients/webos/dist clients/webos/service'",
    "build:service": "bun ./scripts/build-service.ts"
  },
  "dependencies": {
    "@kromatv/core": "workspace:*",
    "@kromatv/mdns-beacon": "workspace:*",
    "@kromatv/tv": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kromatv/bundler": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
