{
  "name": "@kromatv/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA web client TanStack Start SSR shell.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "clients/web"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && bun raise-entry-preload.ts dist/client/_shell.html && bun scripts/precompress.ts dist/client",
    "preview": "vite preview --port 3000",
    "generate-routes": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit && tsc -p tsconfig.sw.json"
  },
  "dependencies": {
    "@kromatv/client": "workspace:*",
    "@kromatv/core": "workspace:*",
    "@kromatv/i18n": "workspace:*",
    "@kromatv/module-sdk": "workspace:*",
    "@kromatv/ui": "workspace:*",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "hls.js": "^1.7.3",
    "react": "19.3.0",
    "react-call": "^2.0.2",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.2",
    "shaka-player": "^5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kromatv/bundler": "workspace:*",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
