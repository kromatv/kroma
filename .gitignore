# Dependencies
node_modules/
.pnpm-store/

# Bun
bun.lockb

# Builds
dist/
build/
# Gradle's per-project cache. Not covered by clients/tv-native/.gitignore's
# `/android`, which is anchored to the generated prebuild folder: gradle also runs
# inside the tracked Expo modules at clients/tv-native/modules/*/android/.
.gradle/
*.tsbuildinfo
.tanstack/
# On-device TV live-dev staging (clients/tizen/.dev-shell)
.dev-shell/

# Rust
server/target/
# Standalone wasm-module crates build into their own target/ (they are their own
# cargo workspaces), which the root server/target/ rule does not cover. Plus the
# built frontend remote (fe/dist), the staging dir, and assembled bundles.
wasm-modules/*/server/target/
wasm-modules/*/ui/dist/
wasm-modules/*/.bundle/
server/data/
# ts-rs generated TypeScript bindings (regenerated from #[derive(TS)], not committed)
server/bindings/

# Desktop: downloaded kroma-mpv sidecar (clients/desktop/scripts/fetch-mpv.sh)
clients/desktop/src-tauri/bin/

# TV packaging artifacts
clients/tizen/*.wgt
clients/tizen/dist/*.wgt
clients/tizen/.buildResult/
clients/tizen/.tizen.env
clients/webos/*.ipk

# Env / local
.env
.env.local
*.local

# Local NAS serve helper kept on disk, never tracked
scripts/serve-nas.sh

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log

# Local runtime data dir (single-port dev: DB, WAL/SHM, logs, image cache).
# Not just the root one: a client run from its own directory writes its own
# (clients/mobile/data holds a SQLite DB + WAL + rotated logs).
/data/
clients/*/data/

# Cloudflare Workers local state
**/.wrangler/

# Test coverage (vitest -> lcov for SonarCloud)
coverage/

# Brand generator intermediate (input to `bunx tauri icon`, not a shipped asset).
scripts/brand/tauri-source-1024.png

# Workbench screenshots (bun run shots): review artefacts, not sources.
.shots/

# Recorded profiles + traces (clients/tv-build/perf-profile.ts). Big, and a
# measurement of one machine at one moment: keep the numbers, not the files.
/perf/

# Rasterised lockup that `bun run store:art` composes the store artwork from.
# The artwork it produces IS committed (clients/*/store/); this is the scratch.
/.store-art/

# Xcode DerivedData for the Apple builds, cached by CI (see _release-mobile.yml).
# Out of ios/ deliberately: `expo prebuild` wipes that directory.
/.derived/

# Python bytecode. Committed once by accident; the scanner reads a .pyc as
# Python source and reports it as a file-encoding problem.
__pycache__/
*.pyc

# Claude Code's per-machine half (the tool writes it; `settings.json` beside it
# is the shareable half and stays tracked if we ever add one). Listed here and
# not only in a personal ~/.config/git/ignore because Biome reads THIS file
# (vcs.useIgnoreFile) and knows nothing about global excludes - without the
# line, `bun run check` fails on a file nobody wrote and nobody can commit.
.claude/settings.local.json

# Emitted from clients/web/src/sw.ts by the Vite plugin in
# clients/web/service-worker.ts, on both `dev` and `build`.
clients/web/public/sw.js
