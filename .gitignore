# Dependencies
node_modules/
.pnpm-store/

# Bun
bun.lockb

# Builds
dist/
build/
# Gradle's per-project cache. Not covered by clients/tv-native/.gitignore's
# `/android`, which is anchored to the generated prebuild folder: gradle also runs
# inside the tracked Expo modules at clients/tv-native/modules/*/android/.
.gradle/
*.tsbuildinfo
.tanstack/
# On-device TV live-dev staging (clients/tizen/.dev-shell)
.dev-shell/

# Rust
server/target/
# The shared build dir modules:pack / kmod-build-plan point every module
# workspace at (see @kroma/module-tools KMOD_TARGET_DIR).
/target/
# Each module under modules/<id> is its own cargo workspace, so it builds into
# its OWN target/ which the rule above does not cover. Its Cargo.lock IS
# committed: a module ships as a native binary in a `.kmod`, and a lock is what
# makes that artifact reproducible. Plus the built frontend remote and the
# staging dir modules:pack assembles bundles in.
modules/*/server/target/
modules/*/ui/dist/
modules/*/.bundle/
server/data/
# ts-rs generated TypeScript bindings (regenerated from #[derive(TS)], not committed)
server/bindings/

# Desktop: downloaded kroma-mpv sidecar (clients/desktop/scripts/fetch-mpv.sh)
clients/desktop/src-tauri/bin/

# Expo prebuild output: the native projects `expo prebuild` writes beside a
# client, regenerated from app.json and never edited by hand. `dist/` and
# `node_modules/` are covered above; these two are not, and one stale copy of
# them is 989 MB of untracked noise (clients/kit, whose source moved to
# apps/kit in #48 - the directory left behind is output only).
clients/*/android/
clients/*/ios/
clients/*/.expo/

# TV packaging artifacts
clients/tizen/*.wgt
clients/tizen/dist/*.wgt
# The webOS JS Service bundle, emitted beside dist/ by build:service.
clients/webos/service/
clients/tizen/.buildResult/
clients/tizen/.tizen.env
clients/webos/*.ipk

# Env / local
.env
.env.*
!.env.example
*.local

# Signing material, by extension rather than by location. The rules above cover
# it wherever a build is EXPECTED to leave some - clients/*/android, and the
# per-client ignore files in clients/mobile and clients/tv-native - which is the
# same thing as saying they stop covering it the moment a keystore lands
# somewhere nobody predicted. These patterns are the backstop for that case, so
# no signing material anywhere in the tree can be swept up by a wide `git add`.
*.jks
*.keystore
*.p12
*.p8
*.pem
*.key
*.mobileprovision

# Local NAS serve helper kept on disk, never tracked
scripts/serve-nas.sh

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log

# Local runtime data dir (single-port dev: DB, WAL/SHM, logs, image cache).
# Not just the root one: a client run from its own directory writes its own
# (clients/mobile/data holds a SQLite DB + WAL + rotated logs).
/data/
clients/*/data/

# Cloudflare Workers local state
**/.wrangler/

# Test coverage (vitest -> lcov for SonarCloud)
coverage/
# cargo-llvm-cov output: the server workspace's, plus one per module workspace
# (they are their own workspaces, so `--workspace` from server/ misses them).
lcov.info

# Brand generator intermediate (input to `bunx tauri icon`, not a shipped asset).
packages/core/scripts/tauri-source-1024.png

# Workbench screenshots (bun run shots): review artefacts, not sources.
.shots/

# Recorded profiles + traces (clients/tv-build/perf-profile.ts). Big, and a
# measurement of one machine at one moment: keep the numbers, not the files.
/perf/

# Rasterised lockup that `bun run store:art` composes the store artwork from.
# The artwork it produces IS committed (clients/*/store/); this is the scratch.
/.store-art/

# Xcode DerivedData for the Apple builds, cached by CI (see _release-mobile.yml).
# Out of ios/ deliberately: `expo prebuild` wipes that directory.
/.derived/

# Python bytecode. Committed once by accident; the scanner reads a .pyc as
# Python source and reports it as a file-encoding problem.
__pycache__/
*.pyc

# Claude Code's per-machine half (the tool writes it; `settings.json` beside it
# is the shareable half and stays tracked if we ever add one). Listed here and
# not only in a personal ~/.config/git/ignore because Biome reads THIS file
# (vcs.useIgnoreFile) and knows nothing about global excludes - without the
# line, `bun run check` fails on a file nobody wrote and nobody can commit.
.claude/settings.local.json

# Emitted from clients/web/src/sw.ts by the Vite plugin in
# clients/web/service-worker.ts, on both `dev` and `build`.
clients/web/public/sw.js

# Kit DOM audit output (bun run kit:dom): review artefacts, not sources.
.dom/
