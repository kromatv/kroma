{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.whisper",
  "name": "Whisper transcription",
  "version": "0.3.23",
  "description": "In-process Whisper subtitle transcription (candle).",
  "component": {
    "instances": 2,
    "memoryMib": 2048,
    "cpuSeconds": 10800
  },
  "engines": {
    "server": ">=0.1.39"
  },
  "contributes": [
    {
      "point": "transcriber"
    }
  ],
  "storage": {
    "core": {
      "read": ["whisper_jobs"],
      "write": ["whisper_jobs"]
    }
  },
  "dataDirs": ["whisper"],
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "model-download",
          "to": ["huggingface.co", "*.huggingface.co", "*.hf.co"],
          "ports": [443]
        }
      ]
    },
    "fs": {
      "read": ["module", "media"],
      "write": ["module"]
    },
    "media": ["decode"]
  }
}
