{
  "$schema": "https://modules.kroma.tv/schemas/2/manifest.json",
  "schemaVersion": 2,
  "id": "tv.kroma.whisper",
  "name": "Whisper transcription",
  "version": "0.2.0",
  "description": "In-process Whisper subtitle transcription (candle).",
  "engines": {
    "server": ">=0.1.38"
  },
  "provides": [
    {
      "kind": "transcriber",
      "id": "whisper"
    }
  ],
  "ports": ["whisper"],
  "storage": {
    "core": {
      "read": ["whisper_jobs"],
      "write": ["whisper_jobs"]
    }
  }
}
