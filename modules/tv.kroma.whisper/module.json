{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.whisper",
  "name": "Whisper transcription",
  "version": "0.3.26",
  "description": "In-process Whisper subtitle transcription (candle).",
  "tagline": "Subtitles for anything you watch, even when none exist.",
  "translations": {
    "fr": {
      "name": "Transcription Whisper",
      "description": "Sous-titres transcrits par Whisper, sur le serveur lui-même (candle).",
      "tagline": "Des sous-titres pour tout ce que vous regardez, même quand il n'en existe aucun."
    }
  },
  "component": {
    "instances": 2,
    "memoryMib": 2048,
    "cpuSeconds": 10800
  },
  "engines": {
    "server": ">=0.1.39"
  },
  "contributes": [
    {
      "point": "transcriber"
    }
  ],
  "storage": {
    "core": {
      "read": ["whisper_jobs"],
      "write": ["whisper_jobs"]
    }
  },
  "dataDirs": ["whisper"],
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "model-download",
          "to": ["huggingface.co", "*.huggingface.co", "*.hf.co"],
          "ports": [443]
        }
      ]
    },
    "fs": {
      "read": ["module", "media"],
      "write": ["module"]
    },
    "media": ["decode"]
  }
}
