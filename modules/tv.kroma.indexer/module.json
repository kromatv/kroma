{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.indexer",
  "name": "Indexers",
  "version": "0.4.34",
  "component": {
    "instances": 4,
    "cpuSeconds": 300
  },
  "description": "Native Cardigann indexer engine: searches trackers from community YAML definitions, no external Torznab aggregator.",
  "engines": {
    "server": ">=0.1.39"
  },
  "settings": {
    "read": ["acqFlaresolverrUrl", "acqIndexersUseVpn"]
  },
  "feRemote": {
    "module": "./remoteEntry.js"
  },
  "definesPoints": [
    {
      "name": "engine",
      "methods": ["caps", "search"]
    },
    {
      "name": "search",
      "methods": ["search", "resolve-download"]
    },
    {
      "name": "db",
      "methods": ["list", "enabled", "get", "note-result"]
    },
    {
      "name": "torrent-fetch",
      "methods": ["fetch"]
    }
  ],
  "contributes": [
    {
      "point": "tv.kroma.indexer/engine",
      "id": "builtin",
      "label": "indexers.builtin",
      "flow": "definition"
    },
    {
      "point": "tv.kroma.indexer/search"
    },
    {
      "point": "tv.kroma.indexer/db"
    },
    {
      "point": "tv.kroma.indexer/torrent-fetch"
    }
  ],
  "consumes": [
    {
      "point": "tv.kroma.indexer/engine"
    },
    {
      "point": "network",
      "optional": true
    }
  ],
  "storage": {
    "adopt": ["indexers"]
  },
  "dataDirs": ["indexer-defs"],
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "indexer",
          "to": ["public", "lan"]
        },
        {
          "purpose": "flaresolverr",
          "to": ["setting:acqFlaresolverrUrl"]
        },
        {
          "purpose": "torrent-file",
          "to": ["public", "lan"]
        },
        {
          "purpose": "indexer-definitions",
          "to": ["codeload.github.com"],
          "ports": [443]
        }
      ]
    },
    "fs": {
      "read": ["module"],
      "write": ["module"]
    }
  }
}
