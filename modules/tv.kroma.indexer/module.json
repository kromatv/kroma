{
  "$schema": "https://modules.kroma.tv/schemas/2/manifest.json",
  "schemaVersion": 2,
  "id": "tv.kroma.indexer",
  "name": "Indexers",
  "version": "0.1.4",
  "engines": {
    "server": ">=0.1.4"
  },
  "provides": [
    {
      "kind": "indexer-engine",
      "id": "builtin",
      "label": "indexers.builtin",
      "flow": "definition"
    }
  ],
  "description": "Native Cardigann indexer engine: searches trackers from community YAML definitions, no external Torznab aggregator.",
  "ports": ["indexer-db", "indexer-search", "torrent-fetch"]
}
