{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.vector",
  "name": "Embeddings",
  "version": "0.3.17",
  "description": "Content embeddings for recommendations and semantic search.",
  "component": {
    "instances": 2,
    "memoryMib": 1024,
    "cpuSeconds": 600
  },
  "engines": {
    "server": ">=0.1.39"
  },
  "contributes": [
    {
      "point": "embedder"
    }
  ],
  "dataDirs": ["models"],
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "model-download",
          "to": ["huggingface.co", "*.huggingface.co", "*.hf.co"],
          "ports": [443]
        }
      ]
    },
    "fs": {
      "read": ["module"],
      "write": ["module"]
    },
    "env": ["KROMA_EMBED_MODEL_DIR"]
  }
}
