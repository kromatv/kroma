{
  "$schema": "https://modules.kroma.tv/schemas/2/manifest.json",
  "schemaVersion": 2,
  "id": "tv.kroma.roku",
  "name": "Roku",
  "version": "0.1.16",
  "description": "A KROMA channel for Roku boxes: found on the LAN, sideloaded from the console, paired like any television.",
  "engines": {
    "server": ">=0.1.39"
  },
  "feRemote": {
    "module": "./remoteEntry.js"
  },
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "roku",
          "to": ["lan"],
          "ports": [8060, 80]
        }
      ],
      "host": true
    },
    "fs": {
      "read": ["module"],
      "write": ["module"]
    }
  }
}
