<?xml version="1.0" encoding="utf-8"?>
<component name="DetailScreen" extends="Group">
  <interface>
    <field id="target" type="assocarray" onChange="onTarget"/>
    <field id="play" type="assocarray"/>
    <field id="active" type="boolean" value="true"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/components/Strings.brs"/>
