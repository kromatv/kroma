<?xml version="1.0" encoding="utf-8"?>
<component name="KromaScene" extends="Scene">
  <interface>
    <field id="launchServer" type="string"/>
    <field id="ready" type="boolean" onChange="onReady"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Api.brs"/>
  <script type="text/brightscript" uri="pkg:/components/Session.brs"/>
  <script type="text/brightscript" uri="pkg:/components/KromaScene.brs"/>
  <children>
    <Rectangle id="background" width="1920" height="1080" color="#0b0b0f"/>
    <Group id="stack"/>
    <Timer id="refresh" repeat="true" duration="2700"/>
  </children>
</component>
