{
  "$schema": "https://modules.kroma.tv/schemas/2/manifest.json",
  "schemaVersion": 2,
  "id": "tv.kroma.engine.transmission",
  "name": "Transmission engine",
  "version": "0.2.1",
  "description": "Transmission RPC as a download sub-engine for the Downloads module. Toggle it to add/remove Transmission from the download-client picker.",
  "engines": {
    "server": ">=0.1.38"
  },
  "dependencies": {
    "tv.kroma.torrents": "^0.2.0"
  },
  "provides": [
    {
      "kind": "download-client",
      "id": "transmission",
      "label": "Transmission",
      "fields": [
        {
          "key": "url",
          "label": "field.url",
          "type": "string",
          "placeholder": "http://nas:9091",
          "required": true
        },
        {
          "key": "username",
          "label": "field.username",
          "type": "string"
        },
        {
          "key": "password",
          "label": "field.password",
          "type": "string",
          "secret": true
        }
      ]
    }
  ]
}
