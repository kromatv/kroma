{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.mdns",
  "name": "mDNS discovery",
  "version": "0.3.17",
  "description": "mDNS / DNS-SD advertising so LAN clients find the server automatically.",
  "engines": {
    "server": ">=0.1.39"
  },
  "settings": {
    "read": ["localDiscovery"]
  },
  "permissions": {
    "net": {
      "discovery": ["mdns"]
    }
  }
}
