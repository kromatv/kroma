{
  "$schema": "https://modules.kroma.tv/schemas/2/manifest.json",
  "schemaVersion": 2,
  "id": "tv.kroma.remote",
  "name": "Remote access",
  "version": "0.3.25",
  "description": "Public HTTPS access: the share / Quick Connect URL plus an optional managed Cloudflare Tunnel connector. Disable it to hide the page + routes.",
  "engines": {
    "server": ">=0.1.39"
  },
  "settings": {
    "read": ["remoteAccess", "remoteAccessToken", "remoteUrl"],
    "write": ["remoteAccess", "remoteAccessToken", "remoteUrl"]
  },
  "feRemote": {
    "module": "./remoteEntry.js"
  },
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "binary-download",
          "to": ["github.com"],
          "ports": [443]
        },
        {
          "purpose": "tunnel",
          "to": ["public"],
          "ports": [7844],
          "proto": ["tcp", "udp"]
        }
      ],
      "host": true
    },
    "fs": {
      "read": ["module"],
      "write": ["module"]
    },
    "run": ["cloudflared", "tar", "ps", "kill"]
  }
}
