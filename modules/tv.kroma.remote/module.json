{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.remote",
  "name": "Remote access",
  "version": "0.3.28",
  "description": "Public HTTPS access: the share / Quick Connect URL plus an optional managed Cloudflare Tunnel connector. Disable it to hide the page + routes.",
  "engines": {
    "server": ">=0.1.39"
  },
  "settings": {
    "read": ["remoteAccess", "remoteAccessToken", "remoteUrl"],
    "write": ["remoteAccess", "remoteAccessToken", "remoteUrl"]
  },
  "feRemote": {
    "module": "./remoteEntry.js"
  },
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "binary-download",
          "to": ["github.com", "*.githubusercontent.com"],
          "ports": [443]
        },
        {
          "purpose": "tunnel",
          "to": ["public"],
          "ports": [7844],
          "proto": ["tcp", "udp"]
        }
      ],
      "host": true
    },
    "fs": {
      "read": ["module"],
      "write": ["module"]
    },
    "run": ["cloudflared"]
  },
  "helpers": {
    "cloudflared": {
      "assets": {
        "linux-x86_64": {
          "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-linux-amd64",
          "sha256": "1f99fb518b83dec2ba8d870a7cc991d82a77e6196295a3d2754ba17ab9f91872"
        },
        "linux-aarch64": {
          "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-linux-arm64",
          "sha256": "3df43aedc9ff291d1735b5cb576cb97e0b157488796db2e32b28aecabb445775"
        },
        "linux-arm": {
          "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-linux-arm",
          "sha256": "74f690f6707182839b63e0465726c7776dd63f0a174390b911d5d71f35cab94e"
        },
        "linux-x86": {
          "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-linux-386",
          "sha256": "4823d2f038395617e04e4070601ab45c0c43f31f15ee7586be299e19ef49d46e"
        },
        "macos-x86_64": {
          "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-darwin-amd64.tgz",
          "sha256": "02f3edfd87684dd5b705607688e4eb4b323f6e777b81e7b3a85af556aa356848",
          "member": "cloudflared"
        },
        "macos-aarch64": {
          "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-darwin-arm64.tgz",
          "sha256": "3586ccf397e98e5f437e60e7c307ca6ac463e110580503af8bb8e6f9ebf831bd",
          "member": "cloudflared"
        }
      }
    }
  }
}
