{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.import.plex",
  "name": "Plex import",
  "version": "0.1.1",
  "description": "Brings a Plex Media Server household over: its libraries, its users and what each of them watched. It only reads Plex.",
  "engines": {
    "server": ">=0.1.39"
  },
  "contributes": [
    {
      "point": "importer",
      "label": "Plex"
    }
  ],
  "storage": {},
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "plex-account",
          "to": ["plex.tv"],
          "ports": [443]
        },
        {
          "purpose": "plex-server",
          "to": ["lan", "*.plex.direct"]
        }
      ]
    }
  }
}
