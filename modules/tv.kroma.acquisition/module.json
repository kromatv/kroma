{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.acquisition",
  "name": "Acquisition",
  "version": "0.5.6",
  "component": {
    "instances": 4,
    "cpuSeconds": 300
  },
  "description": "The acquisition feature: interactive/manual release search, quality scoring, grab + import, and the automatic wanted-list pass. Rides on the Downloads engine and the indexers. Disable it to remove search/grab/auto and hide the settings page.",
  "tagline": "Ask for a film or a series, and it is found and downloaded for you.",
  "translations": {
    "fr": {
      "name": "Acquisition",
      "description": "Recherche manuelle des versions, note de qualité, téléchargement et import, et passage automatique sur la liste des envies. S'appuie sur le moteur de téléchargement et les indexeurs. Désactivez-le pour retirer la recherche et l'automatisme, et masquer sa page de réglages.",
      "tagline": "Demandez un film ou une série : il est trouvé et téléchargé pour vous."
    }
  },
  "engines": {
    "server": ">=0.1.39"
  },
  "settings": {
    "read": [
      "acqDeleteAfterImport",
      "acqEnabled",
      "acqForbiddenKeywords",
      "acqMaxSizeGbEpisode",
      "acqMaxSizeGbMovie",
      "acqMinSeeders",
      "acqMovieLibrary",
      "acqPreferHevc",
      "acqRecycleBin",
      "acqRecycleDays",
      "acqReplaceOnUpgrade",
      "acqRssMinutes",
      "acqStallHours",
      "acqRequiredKeywords",
      "acqResolution",
      "acqSeriesLibrary",
      "namingCase",
      "namingEpisodeFile",
      "namingMovieFile",
      "namingMovieFolder",
      "namingSeasonFolder",
      "namingSeriesFolder"
    ]
  },
  "feRemote": {
    "module": "./remoteEntry.js"
  },
  "dependencies": {
    "tv.kroma.torrents": ">=0.7.0"
  },
  "contributes": [
    {
      "point": "acquisition"
    }
  ],
  "consumes": [
    {
      "point": "tv.kroma.indexer/search"
    },
    {
      "point": "tv.kroma.indexer/db"
    },
    {
      "point": "tv.kroma.torrents/grab"
    },
    {
      "point": "tv.kroma.torrents/db"
    }
  ],
  "storage": {
    "core": {
      "read": [
        "requests",
        "wanted",
        "monitored",
        "downloads",
        "acq_file_tmdb",
        "items",
        "shows",
        "files",
        "libraries",
        "metadata_core",
        "users.id",
        "users.email",
        "users.username",
        "users.avatar_url",
        "users.created_at",
        "users.permissions",
        "users.language",
        "users.pin_hash",
        "users.audio_language",
        "users.subtitle_language"
      ],
      "write": ["requests", "wanted", "monitored", "acq_file_tmdb"]
    }
  },
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "metadata",
          "to": ["api.themoviedb.org"],
          "ports": [443]
        }
      ]
    },
    "fs": {
      "read": ["downloads", "media"],
      "write": ["downloads", "media"]
    }
  }
}
