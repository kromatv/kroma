{
  "$schema": "https://modules.kroma.tv/schemas/3/manifest.json",
  "schemaVersion": 3,
  "id": "tv.kroma.torrents",
  "name": "Torrent downloads",
  "version": "0.6.34",
  "description": "The rqbit download engine, run as a pinned helper, + the downloads queue. Transmission and qBittorrent are their own engine sub-modules that plug into this one.",
  "engines": {
    "server": ">=0.1.39"
  },
  "settings": {
    "read": [
      "namingCase",
      "namingEpisodeFile",
      "namingMovieFile",
      "namingMovieFolder",
      "namingSeasonFolder",
      "namingSeriesFolder",
      "rqbitDownKbps",
      "rqbitPort",
      "rqbitUpKbps",
      "torrentMaxActive",
      "vpnCheckUrl",
      "vpnKillSwitch",
      "vpnWgConfig"
    ],
    "write": [
      "namingCase",
      "namingEpisodeFile",
      "namingMovieFile",
      "namingMovieFolder",
      "namingSeasonFolder",
      "namingSeriesFolder",
      "rqbitDownKbps",
      "rqbitUpKbps",
      "torrentMaxActive"
    ]
  },
  "feRemote": {
    "module": "./remoteEntry.js"
  },
  "dependencies": {
    "tv.kroma.indexer": "^0.4.0"
  },
  "definesPoints": [
    {
      "name": "client",
      "methods": ["test", "add", "status", "pause", "resume", "reannounce", "remove"]
    },
    {
      "name": "grab",
      "methods": ["grab", "list-files", "gate-open", "activate", "drop-data"]
    },
    {
      "name": "db",
      "methods": ["completed", "mark-imported", "set-status"]
    },
    {
      "name": "vpn",
      "methods": ["status", "seal-check", "restart", "bandwidth"]
    }
  ],
  "contributes": [
    {
      "point": "tv.kroma.torrents/client",
      "id": "rqbit"
    },
    {
      "point": "tv.kroma.torrents/grab"
    },
    {
      "point": "tv.kroma.torrents/db"
    },
    {
      "point": "tv.kroma.torrents/vpn"
    }
  ],
  "consumes": [
    {
      "point": "tv.kroma.torrents/client"
    },
    {
      "point": "tv.kroma.indexer/torrent-fetch"
    },
    {
      "point": "tv.kroma.indexer/db"
    },
    {
      "point": "network",
      "optional": true
    }
  ],
  "notifications": [
    {
      "type": "tv.kroma.torrents/download.completed",
      "category": "downloads",
      "push": false,
      "labelKey": "notifications.completed.label",
      "titleKey": "notifications.completed.title",
      "bodyKey": "notifications.completed.body"
    }
  ],
  "storage": {
    "core": {
      "read": [
        "downloads",
        "requests",
        "wanted",
        "items",
        "shows",
        "files",
        "libraries",
        "metadata_core",
        "users.id",
        "users.email",
        "users.username",
        "users.avatar_url",
        "users.created_at",
        "users.permissions",
        "users.language",
        "users.pin_hash",
        "users.audio_language",
        "users.subtitle_language"
      ],
      "write": ["downloads", "wanted"]
    },
    "adopt": ["download_clients"]
  },
  "permissions": {
    "net": {
      "connect": [
        {
          "purpose": "peers",
          "to": ["public", "lan"],
          "proto": ["tcp", "udp"]
        },
        {
          "purpose": "peers-announce",
          "to": ["public"],
          "proto": ["tcp", "udp"]
        },
        {
          "purpose": "torrent-file",
          "to": ["public", "lan"]
        },
        {
          "purpose": "seal-check",
          "to": ["setting:vpnCheckUrl", "api.ipify.org"]
        },
        {
          "purpose": "engine-api",
          "to": ["lan"]
        },
        {
          "purpose": "binary-download",
          "to": ["github.com", "*.githubusercontent.com"],
          "ports": [443]
        }
      ],
      "listen": [
        {
          "purpose": "peers",
          "proto": ["tcp"],
          "port": "setting:rqbitPort"
        }
      ],
      "host": true
    },
    "fs": {
      "read": ["module", "downloads", "media"],
      "write": ["module", "downloads", "media"]
    },
    "run": ["rqbit", "curl"]
  },
  "dataDirs": ["torrents"],
  "helpers": {
    "rqbit": {
      "assets": {
        "linux-x86_64": {
          "url": "https://github.com/ikatson/rqbit/releases/download/v9.1.0/rqbit-linux-amd64",
          "sha256": "921061a82ee6a6b26754c6367886b5b6b4ce5916d3edd5db79c6cd5f2c23499f"
        },
        "linux-aarch64": {
          "url": "https://github.com/ikatson/rqbit/releases/download/v9.1.0/rqbit-linux-arm64",
          "sha256": "5247a363df062f429e53661b7242373bf70603e93efc4d0b459017e6fd209def"
        },
        "linux-arm": {
          "url": "https://github.com/ikatson/rqbit/releases/download/v9.1.0/rqbit-linux-arm-v7",
          "sha256": "7386e7abd052dc3f46a0af6081e66acc5d1bda4b5c95882fd5133ea3088c5856"
        },
        "macos-x86_64": {
          "url": "https://github.com/ikatson/rqbit/releases/download/v9.1.0/rqbit-osx-universal",
          "sha256": "de978a3ddd9732181745a76d054faccd4df3e3caaae98e487292fea6637f1f73"
        },
        "macos-aarch64": {
          "url": "https://github.com/ikatson/rqbit/releases/download/v9.1.0/rqbit-osx-universal",
          "sha256": "de978a3ddd9732181745a76d054faccd4df3e3caaae98e487292fea6637f1f73"
        }
      }
    }
  }
}
