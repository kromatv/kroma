{
  "$schema": "https://modules.kroma.tv/schemas/2/manifest.json",
  "schemaVersion": 2,
  "id": "tv.kroma.torrents",
  "name": "Torrent downloads",
  "version": "0.1.8",
  "engines": {
    "server": ">=0.1.4"
  },
  "dependencies": {
    "tv.kroma.indexer": "^0.1.0"
  },
  "optionalDependencies": {
    "tv.kroma.vpn": "^0.1.0"
  },
  "provides": [
    {
      "kind": "download-client",
      "id": "rqbit"
    }
  ],
  "description": "The embedded librqbit download engine + the downloads queue. Transmission and qBittorrent are their own engine sub-modules that plug into this one.",
  "ports": ["download-grab", "download-db", "download-vpn"]
}
