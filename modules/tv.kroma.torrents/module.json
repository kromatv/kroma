{
  "$schema": "https://modules.kroma.tv/schemas/2/manifest.json",
  "schemaVersion": 2,
  "id": "tv.kroma.torrents",
  "name": "Torrent downloads",
  "version": "0.3.2",
  "description": "The embedded librqbit download engine + the downloads queue. Transmission and qBittorrent are their own engine sub-modules that plug into this one.",
  "engines": {
    "server": ">=0.1.39"
  },
  "dependencies": {
    "tv.kroma.indexer": "^0.4.0"
  },
  "optionalDependencies": {
    "tv.kroma.vpn": "^0.3.0"
  },
  "definesPoints": [
    {
      "name": "client",
      "methods": ["test", "add", "status", "pause", "resume", "reannounce", "remove"]
    },
    {
      "name": "grab",
      "methods": ["grab", "list-files", "gate-open", "activate", "drop-data"]
    },
    {
      "name": "db",
      "methods": ["completed", "mark-imported", "set-status"]
    },
    {
      "name": "vpn",
      "methods": ["status", "seal-check", "restart"]
    }
  ],
  "contributes": [
    {
      "point": "tv.kroma.torrents/client",
      "id": "rqbit"
    },
    {
      "point": "tv.kroma.torrents/grab"
    },
    {
      "point": "tv.kroma.torrents/db"
    },
    {
      "point": "tv.kroma.torrents/vpn"
    }
  ],
  "consumes": [
    {
      "point": "tv.kroma.torrents/client"
    },
    {
      "point": "tv.kroma.indexer/torrent-fetch"
    },
    {
      "point": "tv.kroma.indexer/db"
    },
    {
      "point": "tv.kroma.vpn/proxy",
      "optional": true
    }
  ],
  "storage": {
    "core": {
      "read": [
        "downloads",
        "requests",
        "wanted",
        "items",
        "shows",
        "files",
        "libraries",
        "metadata_core",
        "users.id",
        "users.email",
        "users.username",
        "users.avatar_url",
        "users.created_at",
        "users.permissions",
        "users.language",
        "users.pin_hash",
        "users.audio_language",
        "users.subtitle_language"
      ],
      "write": ["downloads", "wanted"]
    },
    "adopt": ["download_clients"]
  }
}
