  },
  "exports": {
    ".": "./src/index.tsx",
    "./mount": "./src/mount.tsx",
    "./stage": "./src/shared/stage.ts",
    "./build-info": "./src/app/buildMetadata.ts",
    "./hardware": "./src/app/hardwareReadings.ts",
