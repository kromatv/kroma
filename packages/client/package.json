{
  "name": "@kroma/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA server client: the typed API client (KromaClient), the zod schemas that are the wire types, branded ids, and session storage. Shared by every KROMA app.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxscharwath/kroma.git",
    "directory": "packages/client"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./query": "./src/query/index.ts",
    "./test": "./src/kroma-client.fixture.ts",
    "./*": "./src/api/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@kroma/registry": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
