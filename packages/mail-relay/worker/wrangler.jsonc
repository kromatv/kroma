{
  // KROMA mail relay. Deploy from this directory:
  //   bunx wrangler deploy
  // Once, before the first deploy:
  //   bunx wrangler email sending enable kroma.tv      # SPF, DKIM, DMARC land with it
  //   bunx wrangler kv namespace create COUNTERS       # paste the id below
  //   bunx wrangler secret put GRANT_SECRET            # openssl rand -base64 48, NOT the push relay's
  //   bunx wrangler secret put LIMIT_SECRET            # openssl rand -base64 48
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kroma-mail",
  "main": "index.ts",
  "compatibility_date": "2026-07-28",
  "observability": { "enabled": true },
  "workers_dev": true,
  "vars": {
    "FROM_ADDRESS": "no-reply@kroma.tv",
    "FROM_NAME": "KROMA",
    // Where the consent links point. Must be this Worker's own address.
    "PUBLIC_URL": "https://mail.kroma.tv"
  },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@kroma.tv"] }],
  // Daily counters, keyed on an HMAC of the address: the relay keeps no
  // address and no mail, only how many times a mailbox was written to today.
  "kv_namespaces": [
    { "binding": "COUNTERS", "id": "f60d96c32df84c5c915d7ad13b6dfdd2" }
  ],
  "ratelimits": [
    {
      // Consent requests from one address. One server enrols a handful of
      // members; anything beyond is harvesting.
      "name": "ENROL_IP",
      "namespace_id": "2003",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Sends from one address: the ceiling on how loud one server can be.
      "name": "SEND_IP",
      "namespace_id": "2004",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Sends to one MAILBOX, whichever server asks: re-minting buys nothing.
      "name": "SEND_ADDR",
      "namespace_id": "2005",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "routes": [{ "pattern": "mail.kroma.tv", "custom_domain": true }]
}
