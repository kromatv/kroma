{
  // KROMA statistics collector. Deploy from this directory:
  //   bunx wrangler deploy
  // The database was created once, in Western Europe, and its id pasted below:
  //   bunx wrangler d1 create kroma-stats --location weur
  //   bunx wrangler d1 execute kroma-stats --remote --file schema.sql
  // There are no secrets here on purpose: a ping carries nothing worth
  // stealing, and there is nobody to authenticate (see index.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kroma-stats",
  "main": "index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Cloudflare Access guards `/v1/admin/*`. None of these is a credential: the
  // assertion is signed with a key only Cloudflare holds, so this Worker still
  // ships no secret and there is nothing here to leak. Empty means the admin
  // route answers 503, which is the safe way to be unconfigured. Fill them from
  // Zero Trust → Access → Applications after creating the application:
  //   ACCESS_TEAM_DOMAIN  <team>.cloudflareaccess.com
  //   ACCESS_AUD          the application's Application Audience (AUD) tag
  //   ADMIN_EMAILS        comma separated, and the policy should name the same
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": ""
  },
  // Keep a <name>.workers.dev URL alongside the custom domain (fallback + while
  // the stats.kroma.tv cert provisions).
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "kroma-stats",
      "database_id": "d84dac7b-bb36-424b-8e25-00141f7aefc5"
    }
  ],
  // Two different questions, so two different limiters. The binding accepts a
  // 10- or 60-second window and nothing else, so both are per minute; the rules
  // that actually bound a fake fleet are the settling window and the burst
  // sweep, not these.
  "ratelimits": [
    {
      // One install pings once a day, so this is only a flood ceiling. Keyed on
      // the id's hash, never on the id itself.
      "name": "PING_LIMIT",
      "namespace_id": "3001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // The only expensive thing a caller can do is create rows. A household
      // brings up one server; nobody brings up three a minute.
      "name": "NEW_ID_LIMIT",
      "namespace_id": "3002",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  // 03:07 UTC: flag the fleets, write the day down, prune what aged out.
  "triggers": { "crons": ["7 3 * * *"] },
  // Served at https://stats.kroma.tv/. Requires the kroma.tv zone on this
  // Cloudflare account.
  "routes": [{ "pattern": "stats.kroma.tv", "custom_domain": true }]
}
