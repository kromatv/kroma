{
  "name": "@kroma/ui",
  "version": "0.1.3",
  "type": "module",
  "sideEffects": false,
  "description": "KROMA design system: one universal component library. Authored against React Native, it renders natively on Apple TV / Android TV and through react-native-web on Tizen / webOS / desktop / browser. Design tokens live here in TypeScript and generate the CSS custom properties.",
  "imports": {
    "#ui/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./kit": "./src/kit.ts",
    "./kit/*": "./src/components/*/index.ts",
    "./ssr": "./src/ssr.ts",
    "./testing": "./src/testing.tsx",
    "./bundler": "./bundler/index.ts",
    "./workbench-config": "./src/workbench-config.tsx",
    "./tokens": "./src/core/tokens/index.ts",
    "./tokens/colors": "./src/core/tokens/colors.ts",
    "./tokens/*": "./src/core/tokens/*.ts",
    "./fonts": "./src/assets/fonts.ts",
    "./vite": "./vite/index.ts",
    "./css": "./src/styles/kroma.css",
    "./css/*": "./src/styles/kroma.css",
    "./src/assets/*": "./src/assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "shots": "bun ./scripts/shoot-stories.ts",
    "subset-fonts": "python3 ./scripts/subset-fonts.py"
  },
  "dependencies": {
    "@kroma/core": "workspace:*",
    "@tabler/icons-react": "^3.44.0",
    "@tabler/icons-react-native": "^3.46.0",
    "react-native-svg": "^15.15.5",
    "react-tv-space-navigation": "6.0.0-beta1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": "*",
    "expo-video": "~57.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "npm:react-native-tvos@0.86.0-2",
    "react-native-web": "^0.21.2",
    "typescript": "^7.0.2",
    "zod": "^4.4.3",
    "@kroma/workbench": "workspace:*"
  },
  "peerDependenciesMeta": {
    "expo-video": {
      "optional": true
    }
  }
}
