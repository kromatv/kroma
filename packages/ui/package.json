{
  "name": "@kromatv/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KROMA design system: one universal component library. Authored against React Native, it renders natively on Apple TV / Android TV and through react-native-web on Tizen / webOS / desktop / browser. Design tokens live here in TypeScript and generate the CSS custom properties.",
  "author": "Maxime Scharwath <maxscharwath@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromatv/kroma.git",
    "directory": "packages/ui"
  },
  "sideEffects": false,
  "imports": {
    "#ui/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "node": "./src/*.ts",
      "default": "./src/*"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./kit": "./src/kit.ts",
    "./kit/*": "./src/components/*/index.ts",
    "./atomic": "./src/core/atomic/index.ts",
    "./intl": "./src/lib/intl.ts",
    "./device-store": "./src/lib/device-store.ts",
    "./remote-keys": "./src/lib/remote-keys.ts",
    "./ssr": "./src/ssr.ts",
    "./expo-image": "./src/lib/expo-image-backend.tsx",
    "./native-player": "./src/lib/player/native-player.ts",
    "./testing": "./src/testing.tsx",
    "./bundler": "./bundler/index.ts",
    "./workbench-config": "./src/workbench-config.tsx",
    "./mount-root": "./src/lib/mount-root.tsx",
    "./native-film": "./src/native-film.ts",
    "./lockup": "./src/lib/lockup-paths.ts",
    "./css": "./src/styles/css.ts",
    "./css/*": "./src/styles/css.ts",
    "./tokens": "./src/core/tokens/index.ts",
    "./tokens/colors": "./src/core/tokens/colors.ts",
    "./tokens/*": "./src/core/tokens/*.ts",
    "./fonts": "./src/assets/fonts.ts",
    "./vite": "./vite/index.ts",
    "./vite/icon-catalog": "./vite/icon-catalog.ts",
    "./src/assets/*": "./src/assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "shots": "bun ./scripts/shoot-stories.ts",
    "subset-fonts": "python3 ./scripts/subset-fonts.py"
  },
  "dependencies": {
    "@kromatv/client": "workspace:*",
    "@kromatv/core": "workspace:*",
    "@kromatv/i18n": "workspace:*",
    "@kromatv/spatial-nav": "workspace:*",
    "@tabler/icons-react": "^3.49.0",
    "@tabler/icons-react-native": "^3.49.0",
    "react-native-svg": "^15.16.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": "*",
    "expo": "^58.0.16",
    "expo-image": "~58.0.16",
    "expo-video": "~58.0.12",
    "@testing-library/react": ">=16"
  },
  "devDependencies": {
    "@kromatv/react-audit": "workspace:*",
    "@kromatv/workbench": "workspace:*",
    "@tabler/icons": "^3.49.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "magic-string": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-web": "^0.21.2",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "expo-video": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    }
  },
  "files": [
    "src",
    "vite",
    "bundler",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.story.*",
    "!src/**/*.demo.tsx",
    "!src/**/*.docs.mdx"
  ],
  "homepage": "https://kroma.tv"
}
