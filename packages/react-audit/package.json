{
  "name": "@kroma/react-audit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What a React interaction actually costs: which components re-rendered, and which were destroyed and rebuilt. Reads React's own fiber tree, so it names components rather than timing commits.",
