{
  // KROMA module registry. Deploy from the package root (builds the site first):
  //   bun run deploy        (or `bun run deploy:modules` at the repo root)
  // Optional (lifts anonymous GitHub API rate limits):
  //   bunx wrangler secret put GITHUB_TOKEN
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kroma-modules",
  "main": "index.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  // Keep a <name>.workers.dev URL alongside the custom domain (fallback + while
  // the modules.kroma.tv cert provisions).
  "workers_dev": true,
  "vars": {
    "GITHUB_REPO": "maxscharwath/kroma"
  },
  // The React site, built by `bun run build` in the package root. The worker
  // runs first for every request: it owns the catalog routes and injects the
  // catalog into index.html; hashed assets pass through to this directory.
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  // Served at https://modules.kroma.tv/ (bare URL = catalog for the Store,
  // HTML for browsers; /modules.json is the stable registry URL). Requires the
  // kroma.tv zone on this Cloudflare account.
  "routes": [{ "pattern": "modules.kroma.tv", "custom_domain": true }]
}
